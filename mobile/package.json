{
  "name": "hivex-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Hivex native app wrapper (iOS + Android) built with Capacitor. Reuses the live hivex.pt web app.",
  "scripts": {
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "sync": "cap sync",
    "copy": "cap copy",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "assets": "capacitor-assets generate --iconBackgroundColor #0a0f1a --iconBackgroundColorDark #0a0f1a --splashBackgroundColor #0a0f1a --splashBackgroundColorDark #0a0f1a"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/geolocation": "^6.0.1",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/push-notifications": "^6.0.4",
    "@capacitor/share": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2"
  }
}
