# ── Database ──────────────────────────────────────────────────────────────────
# For thousands of concurrent users, point DATABASE_URL at a connection pooler
# (e.g. Neon's built-in pooler, Supabase PgBouncer, or Railway's proxy).
# Direct Postgres connections are limited (usually 100-200); a pooler multiplexes
# thousands of app connections onto a handful of real DB connections.
#
# Neon pooler URL looks like:  postgres://user:pass@ep-xxx.pooler.us-east-2.aws.neon.tech/db?sslmode=require
# Supabase pooler URL looks like: postgres://postgres.xxx:[pass]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/hive_db

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── CORS (comma-separated list of allowed origins) ────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Email notifications ────────────────────────────────────────────────────────
# Gmail: use an App Password (not your normal password).
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
# Port 587 (STARTTLS) is more reliable on serverless platforms than 465 (implicit TLS).
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
ADMIN_EMAIL=geral.hivex@gmail.com
# Random secret — protects the approve/reject links in admin emails
ADMIN_TOKEN=change-this-to-a-long-random-secret
# Full public URL of the deployed app (no trailing slash)
APP_URL=https://your-project.vercel.app

# ── Google Sign-In ────────────────────────────────────────────────────────────
# Public OAuth client ID (exposed to the browser via /api/auth/config).
GOOGLE_CLIENT_ID=

# ── Admin bootstrap (optional) ────────────────────────────────────────────────
# Comma-separated emails auto-promoted to admin on their next login.
ADMIN_USERS=

# ── Cloudflare Turnstile CAPTCHA (optional) ───────────────────────────────────
# Dormant unless both are set. Site key is public (served via /api/auth/config);
# secret key is server-only and verifies the challenge on register.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Push notifications — Firebase Cloud Messaging (optional) ───────────────────
# Dormant unless all three are set. From your Firebase service-account JSON
# (Project settings → Service accounts → Generate new private key). FCM HTTP v1
# reaches Android and iOS (upload your APNs key to Firebase for iOS).
# Keep the private key on one line with literal \n for the newlines.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── AI assistant (optional) ───────────────────────────────────────────────────
# Powered by the Vercel AI Gateway. If unset, the function falls back to the
# platform-injected VERCEL_OIDC_TOKEN (team Gateway credits). Endpoint is dormant
# when neither is available.
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-haiku-4.5
